---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import ParaQuien from '../components/ParaQuien.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import Logros from '../components/Logros.astro';
import Testimonio from '../components/Testimonio.astro';
import SobreCadir from '../components/SobreCadir.astro';
import FAQ from '../components/FAQ.astro';
import Formulario from '../components/Formulario.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="ESO para personas adultas · CADIR Valencia"
  description="Consigue tu Graduado en ESO a cualquier edad. Formación gratuita, grupos reducidos y acompañamiento personal en CADIR, Valencia."
>
  <Nav />
  <main>
    <Hero />
    <Marquee />
    <ParaQuien />
    <ComoFunciona />
    <Logros />
    <Testimonio />
    <SobreCadir />
    <FAQ />
    <Formulario />
  </main>
  <Footer />
</Base>
