---
import { Image } from 'astro:assets';
import Mark from './Mark.astro';
import hero from '../assets/fotos/hero.jpg';
---

<section class="hero" id="top">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="eyebrow reveal">Educación de personas adultas · Valencia</p>
      <h1 class="reveal">
        Tu ESO.<br />
        <em>Ahora <Mark>sí.</Mark></em>
      </h1>
      <p class="hero__lead reveal">
        Si en su día no pudiste terminar el instituto, no pasa nada. En CADIR te acompañamos para que consigas el{" "}
        <strong>Graduado en Educación Secundaria</strong> a tu ritmo, con grupos pequeños y gente que cree en ti.
      </p>
      <div class="hero__actions reveal">
        <a href="#inscripcion" class="btn">
          Quiero informarme
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
            ><path d="M5 12h14M13 6l6 6-6 6"></path></svg
          >
        </a>
        <a href="tel:+34960301644" class="btn btn--ghost">960 301 644</a>
      </div>
    </div>

    <figure class="hero__media reveal">
      <div class="hero__photo">
        <Image
          src={hero}
          alt="Mujer adulta revisando sus apuntes en casa"
          widths={[480, 760, 1100]}
          sizes="(max-width: 860px) 92vw, 44vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="sticker" aria-hidden="true">
        <svg viewBox="0 0 200 200">
          <defs>
            <path id="ring" d="M100 100 m-74 0 a74 74 0 1 1 148 0 a74 74 0 1 1 -148 0"></path>
          </defs>
          <text>
            <textPath href="#ring">GRATUITO · PLAZAS LIMITADAS · VALENCIA · </textPath>
          </text>
        </svg>
        <span>0&nbsp;€</span>
      </div>
      <figcaption class="hero__note">
        <span>+18</span> años. Da igual cuándo lo dejaste.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(40px, 7vw, 96px) clamp(64px, 9vw, 120px);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }

  h1 {
    font-size: clamp(4rem, 17vw, 9.4rem);
    line-height: 0.92;
    letter-spacing: -0.035em;
    margin-bottom: 0.35em;
  }

  h1 em {
    color: var(--plum);
    font-weight: 400;
  }

  .hero__lead {
    max-width: 34ch;
    font-size: clamp(1.08rem, 1.4vw, 1.3rem);
    color: var(--ink-soft);
  }

  .hero__lead strong {
    color: var(--ink);
    font-weight: 600;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .hero__media {
    position: relative;
    margin: 0;
  }

  .hero__photo {
    border-radius: 999px 999px var(--radius) var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--paper-2);
    box-shadow: 14px 14px 0 var(--plum);
  }

  .hero__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 30%;
  }

  .sticker {
    position: absolute;
    top: 8%;
    left: -11%;
    width: clamp(120px, 13vw, 170px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--sun);
    color: var(--ink);
    display: grid;
    place-items: center;
    rotate: -12deg;
  }

  .sticker svg {
    position: absolute;
    inset: 0;
    animation: spin 22s linear infinite;
  }

  .sticker text {
    font: 700 13.4px var(--sans);
    letter-spacing: 0.16em;
    fill: var(--ink);
  }

  .sticker span {
    font: 600 clamp(1.6rem, 2.6vw, 2.3rem) / 1 var(--serif);
  }

  .hero__note {
    position: absolute;
    right: -4%;
    bottom: 9%;
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: 14px;
    padding: 0.7rem 1rem;
    font-size: 0.92rem;
    max-width: 15rem;
    rotate: 3deg;
    line-height: 1.35;
  }

  .hero__note span {
    font: 600 1.6rem/1 var(--serif);
    color: var(--coral);
    margin-right: 0.15em;
  }

  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }

  @media (max-width: 860px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__media {
      max-width: 440px;
      margin-inline: auto 12px;
    }
    .sticker {
      left: -6%;
    }
    .hero__note {
      right: -2%;
    }
  }
</style>
